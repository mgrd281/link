# Linkyo — environment variables. Copy to apps/web/.env.local (never commit real values).
# Where to create each key: docs/SETUP_ACCOUNTS.md

# ── App ─────────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://linkyo.app
NEXT_PUBLIC_CREATOR_DOMAIN=linkyo.app            # creator pages: linkyo.app/<username> (lib/page-url.ts)
NEXT_TELEMETRY_DISABLED=1
# Team area (/admin): SHA-256 (hex) of your own team code. Unset = the demo code in demo mode; with
# Supabase on and this unset, the team code fails closed.
#   echo -n "your-code" | sha256sum
LINKYO_ADMIN_CODE_SHA256=

# ── Feature switches (build time; unset on the live demo deployment) ───────────────────────
NEXT_PUBLIC_PAYMENTS=                            # "test" or "live" (needs Supabase); unset = no payments
LEGAL_REVIEWED=                                  # "1" once a lawyer reviewed the legal texts; needed for NEXT_PUBLIC_PAYMENTS=live
NEXT_PUBLIC_AI_TRY=                              # "1" shows the homepage AI tab (also needs a real recording)

# ── AI page builder (runtime, server only) ─────────────────────────────────────────────────
AI_ENABLED=                                      # "1" turns on /api/ai/* (also needs ANTHROPIC_API_KEY and Supabase)
ANTHROPIC_API_KEY=sk-ant-...                     # server only — never NEXT_PUBLIC
ANTHROPIC_BASE_URL=                              # tests only: the local mock (loopback, never on Vercel)
AI_IP_SALT_SECRET=                               # HMAC salt for daily IP hashes; required on Vercel
AI_ENRICH_OFF=                                   # "1" skips the link-metadata step (tests)
MAINTENANCE_SECRET=                              # bearer token of POST /api/maintenance/storage-purge; unset = 404

# ── Supabase (EU · eu-central-1) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # new key format (anon keys are deprecated end of 2026)
SUPABASE_SECRET_KEY=sb_secret_...                          # server only — never NEXT_PUBLIC
SUPABASE_DB_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres  # migrations/CI only

# ── Auth providers (configured in Supabase Dashboard → Authentication → Providers) ─────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICES_ID=app.linkyo.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=                                # Sign in with Apple key (.p8 content)

# ── Transactional email (custom SMTP for Supabase Auth + notifications) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Linkyo <hello@linkyo.app>"
EMAIL_TRANSPORT=                                     # unset or "console" = log a content-free line; "capture" = JSON files (tests); "tem" = Scaleway. Any other value is an error; live payments need "tem" (the build fails without it)
EMAIL_CAPTURE_DIR=                                   # tests: where "capture" writes (e.g. apps/web/.mail)
SCW_SECRET_KEY=                                      # Scaleway Transactional Email (EMAIL_TRANSPORT=tem), server only
SCW_PROJECT_ID=
SCW_REGION=fr-par

# ── Media ───────────────────────────────────────────────────────────────────────────────────
MUX_TOKEN_ID=                                        # or Cloudflare Stream (see docs/COSTS.md)
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
R2_ACCOUNT_ID=                                       # optional: media at scale (EU jurisdiction bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=linkyo-media-eu

# ── Payments ────────────────────────────────────────────────────────────────────────────────
# Test mode until the founder approves going live. Unset STRIPE_SECRET_KEY = the checkout API answers 503.
STRIPE_SECRET_KEY=sk_test_...                        # server only — never NEXT_PUBLIC
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...       # mounts the payment form; unset = "not set up yet"
STRIPE_API_HOST=                                     # tests only: the local mock (127.0.0.1, never on Vercel)
STRIPE_API_PORT=
STRIPE_API_PROTOCOL=
STRIPE_CONNECT_CLIENT_ID=ca_...
APP_STORE_CONNECT_ISSUER_ID=                         # StoreKit 2 server notifications + API
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY_P8=

# ── Platform APIs (feeds, smart detect) ────────────────────────────────────────────────────
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=                                   # optional — 2026 quota rules, embeds preferred
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_KEY_ID=                                  # MusicKit (Apple Developer account)
APPLE_MUSIC_PRIVATE_KEY_P8=

# ── Push (APNs) ─────────────────────────────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_P8=
APNS_BUNDLE_ID=app.linkyo.ios

# ── Monitoring & product analytics (dashboard only, never on creator pages) ────────────────
SENTRY_DSN=https://...@o0.ingest.de.sentry.io/0
SENTRY_AUTH_TOKEN=                                   # CI only (source maps)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Deploy (CI secrets, not .env) ──────────────────────────────────────────────────────────
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, LHCI_GITHUB_APP_TOKEN

# ── End-to-end tests (Playwright; never set on a deployment) ───────────────────────────────
# E2E_SUPABASE=1 runs the real-account specs; E2E_MOCKS=1 starts e2e/mocks/server.mjs (Anthropic and Stripe mocks).
# PORT (app, default 3100), MOCK_ANTHROPIC_PORT and MOCK_STRIPE_PORT: one set per worktree, nothing else hard-codes a port.
# PW_REUSE_SERVER=1 lets a developer reuse a running server; gates and CI never set it.
