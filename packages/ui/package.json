{
  "name": "@linkyo/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Linkyo product UI components (React + Tailwind v4 + Radix), styled only with @linkyo/tokens.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@linkyo/tokens": "workspace:*",
