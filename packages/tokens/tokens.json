{
  "$description": "Linkyo design tokens v1.0 — single source of truth for web (CSS/Tailwind/TS) and iOS (Swift/Asset Catalog). Derived from docs/BRAND_IDENTITY.md. Mode values live in $extensions['app.linkyo'] (dark, highContrast, highContrastDark).",
  "color": {
    "$type": "color",
    "ink": { "$value": "#0A0A0B", "$description": "Primary text (light mode), dark backgrounds." },
    "paper": { "$value": "#F7F6F2", "$description": "Light background. Warm off-white — never pure #FFF for large areas." },
    "white": { "$value": "#FFFFFF", "$description": "Text on Linkyo Blue and danger fills; small elevated surfaces only." },
    "blue": {
      "50": { "$value": "#F3F5FF" },
      "100": { "$value": "#E6EBFF", "$description": "Selected backgrounds, subtle highlights." },
      "200": { "$value": "#CAD6FF" },
      "300": { "$value": "#94ACFF" },
      "350": { "$value": "#5F80FF", "$description": "Link text on dark surfaces (≥ 4.5:1 on #1C1C1F)." },
      "400": { "$value": "#4D6BFF", "$description": "Linkyo Blue on dark backgrounds: focus rings, icons, links on #0A0A0B." },
      "500": { "$value": "#3355FF", "$description": "Linkyo Blue. Primary actions, focus rings, links, logo." },
      "600": { "$value": "#2440E0", "$description": "Pressed state." },
      "700": { "$value": "#1B34B2" },
      "800": { "$value": "#152787" },
      "900": { "$value": "#0F1C60" },
      "950": { "$value": "#09103F" }
    },
    "lime": {
      "100": { "$value": "#F0FED1" },
      "400": { "$value": "#D4FF3A", "$description": "Spark. Rare accent: Live, badges, celebration. Max 5 % of any screen. Always with ink text." },
      "950": { "$value": "#222B04" }
    },
    "gray": {
      "25": { "$value": "#FCFBF9" },
      "50": { "$value": "#F7F6F2" },
      "75": { "$value": "#F2F1ED" },
      "100": { "$value": "#EEEDE9" },
      "200": { "$value": "#DFDDD8" },
      "300": { "$value": "#CDCBC5" },
      "400": { "$value": "#A2A09A" },
      "500": { "$value": "#7E7B76" },
      "600": { "$value": "#615F59" },
      "700": { "$value": "#474540" },
      "800": { "$value": "#2F2E2A" },
      "900": { "$value": "#1C1A17" },
      "950": { "$value": "#100F0D" }
    },
    "night": {
      "$description": "Cool near-black surfaces for dark mode (brand §4.2).",
      "0": { "$value": "#0A0A0B", "$description": "Dark background." },
      "50": { "$value": "#0F0F11" },
      "100": { "$value": "#141416", "$description": "Dark surface." },
      "200": { "$value": "#1C1C1F", "$description": "Dark elevated surface." },
      "300": { "$value": "#26262A" },
      "400": { "$value": "#303035" }
    },
    "success": {
      "50": { "$value": "#F0FBF3" },
      "100": { "$value": "#DCF6E3" },
      "400": { "$value": "#62D28F" },
      "500": { "$value": "#12B76A" },
      "600": { "$value": "#00834A" },
      "700": { "$value": "#007A44" },
      "950": { "$value": "#0F2719" }
    },
    "warning": {
      "50": { "$value": "#FFF6EE" },
      "100": { "$value": "#FFE9D8" },
      "400": { "$value": "#FFB168" },
      "500": { "$value": "#F79009" },
      "600": { "$value": "#A96000" },
      "700": { "$value": "#9E5900" },
      "950": { "$value": "#301D0A" }
    },
    "danger": {
      "50": { "$value": "#FFF5F4" },
      "100": { "$value": "#FFE8E4" },
      "400": { "$value": "#FF7263" },
      "500": { "$value": "#F04438" },
      "600": { "$value": "#D6332A" },
      "700": { "$value": "#C2362C" },
      "950": { "$value": "#371713" }
    }
  },
  "semantic": {
    "$type": "color",
    "$description": "Product UI roles. $value = light mode; $extensions['app.linkyo'].dark = dark mode. All text pairs verified ≥ 4.5:1 (see test/tokens.test.ts).",
    "canvas": { "$value": "{color.paper}", "$extensions": { "app.linkyo": { "dark": "{color.night.0}" } }, "$description": "Page background." },
    "canvas-muted": { "$value": "{color.gray.75}", "$extensions": { "app.linkyo": { "dark": "{color.night.50}" } }, "$description": "Secondary regions (sidebar, wells)." },
    "surface": { "$value": "{color.gray.25}", "$extensions": { "app.linkyo": { "dark": "{color.night.100}" } }, "$description": "Cards, panels." },
    "surface-elevated": { "$value": "{color.white}", "$extensions": { "app.linkyo": { "dark": "{color.night.200}" } }, "$description": "Menus, popovers, dialogs." },
    "hover": { "$value": "#0A0A0B0A", "$extensions": { "app.linkyo": { "dark": "#F7F6F20F" } }, "$description": "Hover overlay (ink 4 % / paper 6 %)." },
    "pressed": { "$value": "#0A0A0B14", "$extensions": { "app.linkyo": { "dark": "#F7F6F21A" } }, "$description": "Pressed overlay (ink 8 % / paper 10 %)." },
    "hover-inverse": { "$value": "#F7F6F21F", "$extensions": { "app.linkyo": { "dark": "#0A0A0B14" } }, "$description": "Hover overlay on inverse surfaces (toasts, tooltips)." },
    "selected": { "$value": "{color.blue.100}", "$extensions": { "app.linkyo": { "dark": "#4D6BFF29" } }, "$description": "Selected rows, active nav." },
    "selected-fg": { "$value": "{color.blue.700}", "$extensions": { "app.linkyo": { "dark": "{color.blue.300}" } }, "$description": "Text/icons on selected backgrounds (≥ 4.5:1)." },
    "line": { "$value": "#0A0A0B17", "$extensions": { "app.linkyo": { "dark": "#F7F6F214", "highContrast": "#0A0A0B33", "highContrastDark": "#F7F6F233" } }, "$description": "Default border (ink 9 % / white 8 %)." },
    "line-strong": { "$value": "#0A0A0B29", "$extensions": { "app.linkyo": { "dark": "#F7F6F224", "highContrast": "#0A0A0B57", "highContrastDark": "#F7F6F252" } }, "$description": "Emphasized dividers." },
    "line-input": { "$value": "#0A0A0B78", "$extensions": { "app.linkyo": { "dark": "#F7F6F261", "highContrast": "#0A0A0BA3", "highContrastDark": "#F7F6F299" } }, "$description": "Form control boundary, ≥ 3:1 (WCAG 1.4.11)." },
    "fg": { "$value": "{color.ink}", "$extensions": { "app.linkyo": { "dark": "{color.paper}" } }, "$description": "Primary text." },
    "fg-secondary": { "$value": "#0A0A0BA3", "$extensions": { "app.linkyo": { "dark": "#F7F6F2A3", "highContrast": "#0A0A0BD1", "highContrastDark": "#F7F6F2D1" } }, "$description": "Secondary text, 64 % opacity (≥ 5.7:1)." },
    "fg-tertiary": { "$value": "#0A0A0B94", "$extensions": { "app.linkyo": { "dark": "#F7F6F294", "highContrast": "#0A0A0BC2", "highContrastDark": "#F7F6F2C2" } }, "$description": "Placeholders, meta, 58 % (≥ 4.6:1)." },
    "fg-disabled": { "$value": "#0A0A0B66", "$extensions": { "app.linkyo": { "dark": "#F7F6F266" } }, "$description": "Disabled text (exempt from contrast, never the only signal)." },
    "fg-inverse": { "$value": "{color.paper}", "$extensions": { "app.linkyo": { "dark": "{color.ink}" } } },
    "primary": { "$value": "{color.blue.500}", "$extensions": { "app.linkyo": { "dark": "{color.blue.500}" } }, "$description": "Primary action fill. Stays #3355FF in dark mode so white labels keep 5.4:1." },
    "primary-hover": { "$value": "#2C4AF0", "$extensions": { "app.linkyo": { "dark": "#3D5DFF" } } },
    "primary-pressed": { "$value": "{color.blue.600}", "$extensions": { "app.linkyo": { "dark": "{color.blue.600}" } } },
    "primary-fg": { "$value": "{color.white}", "$extensions": { "app.linkyo": { "dark": "{color.white}" } } },
    "link": { "$value": "{color.blue.500}", "$extensions": { "app.linkyo": { "dark": "{color.blue.350}" } }, "$description": "Links and blue text." },
    "focus": { "$value": "{color.blue.500}", "$extensions": { "app.linkyo": { "dark": "{color.blue.400}" } }, "$description": "Focus ring (2 px, 2 px offset)." },
    "spark": { "$value": "{color.lime.400}", "$extensions": { "app.linkyo": { "dark": "{color.lime.400}" } }, "$description": "Live / celebration accent. ≤ 5 % of a screen." },
    "spark-fg": { "$value": "{color.ink}", "$extensions": { "app.linkyo": { "dark": "{color.ink}" } } },
    "success": { "$value": "{color.success.500}", "$extensions": { "app.linkyo": { "dark": "{color.success.500}" } }, "$description": "Indicators and icons." },
    "success-strong": { "$value": "{color.success.700}", "$extensions": { "app.linkyo": { "dark": "{color.success.400}" } }, "$description": "Success text (≥ 4.5:1)." },
    "success-subtle": { "$value": "{color.success.50}", "$extensions": { "app.linkyo": { "dark": "{color.success.950}" } } },
    "warning": { "$value": "{color.warning.500}", "$extensions": { "app.linkyo": { "dark": "{color.warning.500}" } } },
    "warning-strong": { "$value": "{color.warning.700}", "$extensions": { "app.linkyo": { "dark": "{color.warning.400}" } } },
    "warning-subtle": { "$value": "{color.warning.50}", "$extensions": { "app.linkyo": { "dark": "{color.warning.950}" } } },
    "danger": { "$value": "{color.danger.500}", "$extensions": { "app.linkyo": { "dark": "{color.danger.500}" } } },
    "danger-strong": { "$value": "{color.danger.700}", "$extensions": { "app.linkyo": { "dark": "{color.danger.400}" } }, "$description": "Destructive text (≥ 4.5:1)." },
    "danger-subtle": { "$value": "{color.danger.50}", "$extensions": { "app.linkyo": { "dark": "{color.danger.950}" } } },
    "danger-fill": { "$value": "{color.danger.600}", "$extensions": { "app.linkyo": { "dark": "{color.danger.600}" } }, "$description": "Filled destructive button (confirmation dialogs only)." },
    "danger-fill-fg": { "$value": "{color.white}", "$extensions": { "app.linkyo": { "dark": "{color.white}" } } },
    "scrim": { "$value": "#0A0A0B7A", "$extensions": { "app.linkyo": { "dark": "#0A0A0BA3" } }, "$description": "Overlay behind dialogs and sheets." },
    "skeleton": { "$value": "#0A0A0B0F", "$extensions": { "app.linkyo": { "dark": "#F7F6F214" } } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist", "IBM Plex Sans Arabic", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$extensions": { "app.linkyo": { "faces": { "Geist": "geist", "IBM Plex Sans Arabic": "plex-arabic" } } }, "$description": "Product UI. Arabic glyphs fall through to IBM Plex Sans Arabic." },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$extensions": { "app.linkyo": { "faces": { "Geist Mono": "geist-mono" } } } },
      "display": { "$value": ["Geist", "IBM Plex Sans Arabic", "ui-sans-serif", "system-ui", "sans-serif"], "$extensions": { "app.linkyo": { "faces": { "Geist": "geist", "IBM Plex Sans Arabic": "plex-arabic" } } } },
      "arabic": { "$value": ["IBM Plex Sans Arabic", "Geeza Pro", "Noto Sans Arabic", "sans-serif"], "$extensions": { "app.linkyo": { "faces": { "IBM Plex Sans Arabic": "plex-arabic" } } } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 },
      "black": { "$value": 900 }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Type scale (web, rem; 1rem = 16px). Display styles use tracking −3 %.",
    "display-xl": { "$value": { "fontSize": "72px", "lineHeight": 1.0, "fontWeight": 800, "letterSpacing": "-0.03em" } },
    "display": { "$value": { "fontSize": "56px", "lineHeight": 1.05, "fontWeight": 800, "letterSpacing": "-0.03em" } },
    "h1": { "$value": { "fontSize": "36px", "lineHeight": 1.15, "fontWeight": 700, "letterSpacing": "-0.02em" } },
    "h2": { "$value": { "fontSize": "28px", "lineHeight": 1.2, "fontWeight": 700, "letterSpacing": "-0.02em" } },
    "h3": { "$value": { "fontSize": "22px", "lineHeight": 1.3, "fontWeight": 600, "letterSpacing": "-0.01em" } },
    "body-lg": { "$value": { "fontSize": "18px", "lineHeight": 1.55, "fontWeight": 400, "letterSpacing": "0em" } },
    "body": { "$value": { "fontSize": "16px", "lineHeight": 1.55, "fontWeight": 400, "letterSpacing": "0em" } },
    "small": { "$value": { "fontSize": "14px", "lineHeight": 1.45, "fontWeight": 500, "letterSpacing": "0em" } },
    "caption": { "$value": { "fontSize": "12px", "lineHeight": 1.4, "fontWeight": 500, "letterSpacing": "0.01em" } }
  },
  "leading": {
    "$type": "number",
    "none": { "$value": 1 },
    "tight": { "$value": 1.1 },
    "snug": { "$value": 1.3 },
    "normal": { "$value": 1.55 }
  },
  "tracking": {
    "$type": "dimension",
    "wordmark": { "$value": "-0.02em", "$description": "Logo wordmark." },
    "display": { "$value": "-0.03em" },
    "tight": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.04em", "$description": "Small uppercase labels only." }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "4 px base, 8 px rhythm. Keys follow the 4 px multiplier (0_5 = 2 px).",
    "0": { "$value": "0px" },
    "0_5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" },
    "creator-gutter": { "$value": "20px", "$description": "Creator page side padding (mobile)." }
  },
  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "32px", "$description": "Button sm." },
    "control-md": { "$value": "40px", "$description": "Button md, inputs." },
    "control-lg": { "$value": "48px", "$description": "Button lg." },
    "control-xl": { "$value": "56px", "$description": "Button xl — creator page links." },
    "icon-button": { "$value": "40px", "$description": "Icon button (web). iOS uses touch-target." },
    "touch-target": { "$value": "44px", "$description": "Minimum hit area everywhere." },
    "icon-sm": { "$value": "16px" },
    "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "24px" },
    "avatar-sm": { "$value": "32px" },
    "avatar-md": { "$value": "40px" },
    "avatar-lg": { "$value": "64px" },
    "avatar-xl": { "$value": "96px" },
    "avatar-2xl": { "$value": "128px" },
    "dot": { "$value": "8px", "$description": "Status dots (Live)." }
  },
  "icon": {
    "stroke": { "$type": "number", "$value": 1.75, "$description": "Lucide stroke width." }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "6px" },
    "sm": { "$value": "10px" },
    "md": { "$value": "14px", "$description": "Buttons, inputs." },
    "lg": { "$value": "20px", "$description": "Cards." },
    "xl": { "$value": "28px", "$description": "Sheets, large media." },
    "full": { "$value": "9999px", "$description": "Pills, avatars." }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "focus": { "$value": "2px" },
    "focus-offset": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "3 elevation levels. Prefer borders + subtle shadow.",
    "e1": {
      "$value": { "color": "#0000000F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      "$extensions": { "app.linkyo": { "dark": { "color": "#00000080", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } } }
    },
    "e2": {
      "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" },
      "$extensions": { "app.linkyo": { "dark": { "color": "#0000008C", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" } } }
    },
    "e3": {
      "$value": { "color": "#00000024", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" },
      "$extensions": { "app.linkyo": { "dark": { "color": "#000000A6", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" } } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "micro": { "$value": "120ms", "$description": "Hover, press, toggles." },
      "standard": { "$value": "200ms", "$description": "Most transitions." },
      "slow": { "$value": "320ms", "$description": "Sheets and pages." }
    },
    "delay": {
      "$type": "duration",
      "tooltip": { "$value": "400ms", "$description": "Tooltip open delay." },
      "tooltip-skip": { "$value": "200ms", "$description": "Moving between tooltips." },
      "toast": { "$value": "6000ms", "$description": "Toast with Undo stays this long." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] }
    },
    "spring": {
      "$type": "number",
      "response": { "$value": 0.35, "$description": "iOS spring response (s)." },
      "damping": { "$value": 0.85, "$description": "iOS spring damping fraction." }
    },
    "scale": {
      "$type": "number",
      "pressed": { "$value": 0.98 },
      "lift": { "$value": 1.03, "$description": "Dragged item." }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4 },
    "secondary": { "$value": 0.64 },
    "hover": { "$value": 0.06, "$description": "Hover overlay on creator buttons (currentColor)." },
    "pressed": { "$value": 0.12 },
    "glass": { "$value": 0.62, "$description": "Glass button surface opacity." }
  },
  "blur": {
    "$type": "dimension",
    "glass": { "$value": "20px", "$description": "Glass button backdrop blur." },
    "ambient": { "$value": "64px", "$description": "Desktop ambient background behind creator pages." }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 1000 },
    "modal": { "$value": 1100 },
    "popover": { "$value": 1200 },
    "toast": { "$value": 1300 },
    "tooltip": { "$value": 1400 }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px", "$description": "Dashboard shows sidebar + editor + live preview." },
    "2xl": { "$value": "1536px" }
  },
  "layout": {
    "$type": "dimension",
    "creator": { "$value": "560px", "$description": "Creator page column (max width)." },
    "sidebar": { "$value": "248px", "$description": "Dashboard sidebar." },
    "content": { "$value": "1120px", "$description": "Dashboard content (max width)." },
    "preview": { "$value": "390px", "$description": "Live phone preview width." },
    "prose": { "$value": "640px", "$description": "Max line length for long text." },
    "menu": { "$value": "224px", "$description": "Menus and popovers (min width)." }
  },
  "aspect": {
    "$type": "string",
    "video": { "$value": "16 / 9" },
    "short": { "$value": "9 / 16" },
    "square": { "$value": "1 / 1" },
    "portrait": { "$value": "4 / 5" },
    "og": { "$value": "1200 / 630" }
  },
  "creator": {
    "$description": "Creator page system. Colors are generated per creator by src/creator (OKLCH + contrast guard); these tokens define the building blocks.",
    "button": {
      "height": { "$type": "dimension", "$value": "{size.control-xl}" },
      "shape": {
        "$type": "dimension",
        "square": { "$value": "{radius.xs}" },
        "rounded": { "$value": "{radius.md}" },
        "pill": { "$value": "{radius.full}" }
      },
      "style": {
        "$type": "string",
        "filled": { "$value": "filled", "$description": "Accent fill, accent-contrast label." },
        "outline": { "$value": "outline", "$description": "Transparent, 1.5px strong border, text label." },
        "soft": { "$value": "soft", "$description": "Surface-2 fill, text label." },
        "glass": { "$value": "glass", "$description": "Translucent surface with backdrop blur." },
        "shadow": { "$value": "shadow", "$description": "Surface fill with e2 shadow." },
        "minimal": { "$value": "minimal", "$description": "Text + arrow, divider between items." }
      }
    },
    "card": {
      "$description": "Media cards on creator pages (list rows, tiles, featured). Follows the button shape, capped so large cards never become stadiums.",
      "shape": {
        "$type": "dimension",
        "square": { "$value": "{radius.xs}" },
        "rounded": { "$value": "{radius.md}" },
        "pill": { "$value": "{radius.lg}" }
      }
    },
    "pairing": {
      "classic": { "$type": "string", "$value": "classic", "$extensions": { "app.linkyo": { "label": "Classic", "display": { "family": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "face": "inter", "weight": 700, "tracking": "-0.02em" }, "body": { "family": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "face": "inter", "weight": 400 } } } },
      "stage": { "$type": "string", "$value": "stage", "$extensions": { "app.linkyo": { "label": "Stage", "display": { "family": ["Anton", "Impact", "sans-serif"], "face": "anton", "weight": 400, "tracking": "0.01em", "uppercase": true }, "body": { "family": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "face": "inter", "weight": 400 } } } },
      "editorial": { "$type": "string", "$value": "editorial", "$extensions": { "app.linkyo": { "label": "Editorial", "display": { "family": ["Instrument Serif", "Georgia", "serif"], "face": "instrument-serif", "weight": 400, "tracking": "-0.01em" }, "body": { "family": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "face": "inter", "weight": 400 } } } },
      "modern": { "$type": "string", "$value": "modern", "$extensions": { "app.linkyo": { "label": "Modern", "display": { "family": ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"], "face": "space-grotesk", "weight": 700, "tracking": "-0.02em" }, "body": { "family": ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"], "face": "space-grotesk", "weight": 400 } } } },
