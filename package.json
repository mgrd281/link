{
  "name": "linkyo",
  "private": true,
  "description": "Linkyo — One link. Everything you create.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@linkyo/web...",
    "lint": "turbo run lint && pnpm check:tokens",
    "check:tokens": "node packages/config/token-guard/cli.mjs",
    "check:tokens-drift": "pnpm --filter @linkyo/tokens build && git diff --exit-code -- apps/ios/Packages/LinkyoDesignSystem/Sources/LinkyoDesignSystem/Generated",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "pnpm --filter @linkyo/tokens build",
    "prepare": "lefthook install || true"
  },
  "prettier": "@linkyo/config/prettier",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@linkyo/config": "workspace:*",
    "lefthook": "2.2.2",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "catalog:"
  }
}
