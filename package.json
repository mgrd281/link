{
  "name": "linkyo",
  "private": true,
  "description": "Linkyo \u2014 One link. Everything you create.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@linkyo/web...",
    "lint": "turbo run lint && pnpm check:tokens",
    "check:tokens": "node packages/config/token-guard/cli.mjs",
    "check:tokens-drift": "pnpm --filter @linkyo/tokens build && git diff --exit-code -- apps/ios/Packages/LinkyoDesignSystem/Sources/LinkyoDesignSystem/Generated",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "pnpm --filter @linkyo/tokens build",
    "prepare": "lefthook install || true",
    "db:start": "npx -y supabase@2.122.1 start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,storage-api,postgres-meta,supavisor",
    "db:stop": "npx -y supabase@2.122.1 stop",
    "db:reset": "npx -y supabase@2.122.1 db reset",
    "db:test": "npx -y supabase@2.122.1 test db",
    "db:lint": "npx -y supabase@2.122.1 db lint --level warning",
    "db:types": "npx -y supabase@2.122.1 gen types typescript --local --schema public | (echo '/* eslint-disable -- generated by `pnpm db:types` from supabase/migrations (do not edit by hand). */' && cat) > apps/web/src/lib/supabase/database.types.ts && prettier --write apps/web/src/lib/supabase/database.types.ts"
  },
  "prettier": "@linkyo/config/prettier",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@linkyo/config": "workspace:*",
    "lefthook": "2.2.2",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "catalog:"
  }
}
