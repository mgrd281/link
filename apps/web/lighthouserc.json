{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start -p 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/de/directions/gallery?chrome=0",
        "http://localhost:3100/de/directions/stage?chrome=0",
        "http://localhost:3100/de/directions/mosaic?chrome=0"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "third-party-summary": "off"
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
